{
  "name": "pharmacy-system",
  "version": "1.0.0",
  "description": "Express Pharmaceutical Wholesale - Management Suite Portal",
  "main": "pharmacy-backend/server.js",
  "type": "commonjs",
  "workspaces": [
    "pharmacy-backend",
    "pharmacy-frontend"
  ],
  "scripts": {
    "install-all": "npm install --workspaces && npm install",
    "backend-dev": "npm run dev --workspace=pharmacy-backend",
    "backend-start": "npm start --workspace=pharmacy-backend",
    "frontend-dev": "npm run dev --workspace=pharmacy-frontend",
    "frontend-build": "npm run build --workspace=pharmacy-frontend",
    "frontend-start": "npm start --workspace=pharmacy-frontend"
  },
  "keywords": [
    "pharmacy",
    "wholesale",
    "nextjs",
    "express",
    "postgresql"
  ],
  "author": "Yonatan Shitaye",
  "license": "ISC",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "compression": "^1.7.4",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.21.0"
  }
}